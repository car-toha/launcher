{
  "schemaVersion": 1,
  "id": "mobilecraft",
  "version": "${version}",
  "name": "MobileCraft",
  "description": "Делает Java-клиент удобным на телефоне: компактный чат сверху по центру, повтор последней команды, микрофон-переключатель для Simple Voice Chat.",
  "authors": ["anton"],
  "license": "GPL-3.0",
  "environment": "client",
  "entrypoints": {
    "preLaunch": ["ru.mobilecraft.client.VoiceChatDefaults"],
    "client": ["ru.mobilecraft.client.MobileCraftClient"]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "~26.1.2"
  },
  "suggests": {
    "voicechat": "*"
  }
}
